{
  "input": {
    "implementation": "local-whisper",
    "config": {
      "model_path": "/absolute/path/to/installed/whisper-model",
      "max_audio_frames": 960000,
      "partial_frames": 8000,
      "transcription": {"language": "ko"}
    }
  },
  "output": {
    "implementation": "local-piper",
    "config": {"voice_path": "/absolute/path/to/installed/voice.onnx"}
  },
  "capture": {"device": null, "block_frames": 1600, "queue_size": 8},
  "playback": {"device": null, "block_frames": 1600, "queue_size": 8},
  "interaction": {"submit": "confirm", "read_responses": true, "text_chunk_chars": 160}
}
