// dok configuration: edit values, then run ish_reload to apply them.
// Line comments (//) and block comments (/* ... */) are supported. Trailing commas are not allowed.
// All settings are shown. Explicit values take precedence; omitted fields use this version's defaults.
// Widths and horizontal gaps use terminal cells; spacing.after/basic_after use rows. _s means seconds; _min means minutes.
// Edit shared RGB colors in theme.colors and map UI roles in theme.roles. null roles follow the terminal.
// Other color/background fields use theme role or palette names; region nulls inherit as documented.
// toolbar.background also accepts a toolbar-only #RRGGBB override; toolbar outer padding is measured in cells.
// Shortcut entry colors and visualizer gradient stops remain independent #RRGGBB values.
{
  // Dock width and mode keys.
  "dock": {
    // Dock mode key sequences.
    "keys": {
      // Toggle dock visibility. Opens maximized by default and fits the available space. Examples: ["c-w"], ["f8"].
      "toggle": ["c-w"]
    },
    // Overall dock width; widget rows are centered within it.
    "width": {
      // Width mode: fixed uses terminal cells; ratio uses a fraction of the ish PTY width.
      "mode": "fixed",
      // Fixed width needs at least 39 cells to fit the shortcut slots. Ratio accepts a fraction greater than 0 and at most 1. Both fit the available width.
      "value": 80
    },
    // Mouse reporting and dock-only action routing.
    "mouse": {
      // Enable mouse actions on visible dock and notification regions. General popups always enable mouse support while focused, then restore the previous state. Terminal text selection requires Shift+drag.
      "enabled": false
    }
  },
  // Linux output audio capture. Native Windows audio is not included.
  "audio": {
    // Enable Linux output audio capture. false prevents capture processes from running.
    "enabled": true,
    // Output monitor names to capture. [] uses all discovered output monitors.
    "sources": []
  },
  // Shared clock settings.
  "clock": {
    // Shared IANA timezone for date, time, weekday art and weather timestamps. null uses the system local timezone.
    "timezone": null
  },
  // Widget content, appearance and spacing.
  "widgets": {
    // Maximized daily forecast. Requests send configured coordinates to Open-Meteo.
    "weather": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical spacing in terminal rows.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 1,
        // Basic-mode trailing rows. null uses after.
        "basic_after": null
      },
      // Forecast location. null disables weather requests. Supply your own lat and lon.
      // Object format: {"lat": <lat>, "lon": <lon>, "label": "<location name>"}
      "location": null,
      // Temperature unit: celsius or fahrenheit.
      "unit": "celsius",
      // Forecast days to display, from 1 to the Open-Meteo maximum of 16. Fewer days are shown when space is limited.
      "days": 7,
      // Positive whole minutes between scheduled weather requests. Successful forecasts keep this cadence when the dock reopens. After a failed request, explicitly reopening the dock retries immediately; an in-flight request is never duplicated.
      "refresh_min": 30,
      // Weather foreground and low-temperature colors.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground",
        // Low temperature foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "low_color": "low_temp"
      },
      // Target weather width as a fraction of the dock width. Enough space is retained to prevent temperature overlap.
      "width_ratio": 0.5,
      // Horizontal icon offset in cells. Negative moves left; positive moves right. Clamped within each column.
      "icon_offset": -1,
      // Icons or single-line text for each weather condition.
      "icons": {
        // Clear sky icon.
        "clear": "☀",
        // Partly cloudy icon.
        "partly_cloudy": "🌤",
        // Cloudy icon.
        "cloudy": "☁",
        // Fog icon.
        "fog": "🌫",
        // Rain icon.
        "rain": "🌧",
        // Snow icon.
        "snow": "❄",
        // Thunderstorm icon.
        "thunder": "⛈",
        // Unknown weather icon. Also used when no forecast location is configured.
        "unknown": "?"
      },
      // null uses localized weekdays (English uses small capitals). An array overrides Monday through Sunday; custom labels are preserved.
      "weekdays": null
    },
    // Maximized pyfiglet weekday art.
    "weekday": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical spacing in terminal rows.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 1,
        // Basic-mode trailing rows. null uses after.
        "basic_after": null
      },
      // Installed pyfiglet font name. Examples: future, slant, ansi_regular, small.
      "font": "future",
      // Weekday art foreground color.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground"
      },
      // Use abbreviated English weekdays. Automatically falls back to abbreviations or plain text when space is limited.
      "abbreviated": false
    },
    // Maximized date row.
    "date": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical spacing in terminal rows.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 0,
        // Basic-mode trailing rows. null uses after.
        "basic_after": null
      },
      // Date foreground color and bold text.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground",
        // Render text in bold.
        "bold": true
      },
      // Date format. %d is day, %B localized month (uppercase in English), %Y year. Empty hides this row.
      "format": "%d %B, %Y."
    },
    // Maximized time row.
    "time": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical spacing in terminal rows.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 2,
        // Basic-mode trailing rows. null uses after.
        "basic_after": null
      },
      // Time foreground color.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground"
      },
      // Time format. %H is hour, %M minute, %S second. %S enables second updates; empty hides this row.
      "format": "-%H:%M-"
    },
    // Linux output audio visualizer.
    "visualizer": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical spacing in terminal rows.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 0,
        // Basic-mode trailing rows. null uses after.
        "basic_after": null
      },
      // Solid color or horizontal gradient stops.
      "style": {
        // Colors in #RRGGBB format. One color gives a solid fill; multiple colors form a left-to-right gradient.
        "colors": ["#67e8f9", "#c084fc", "#fb7185"]
      },
      // Visualizer length in terminal cells. Clamped to the dock width.
      "width": 38
    },
    // Playback progress bar. Seek is available when the connected player supports it.
    "progress": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical spacing in terminal rows.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 0,
        // Basic-mode trailing rows. null uses after.
        "basic_after": null
      },
      // Theme selector for time labels and remaining track. The played track and position marker use theme.roles.foreground.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "muted"
      },
      // Progress bar length in cells, excluding the time labels. Clamped to the available space.
      "width": 48
    },
    // Application title and audio connection messages.
    "title": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical spacing in terminal rows.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 1,
        // Basic-mode trailing rows. null uses after.
        "basic_after": 0
      },
      // Foreground appearance.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground"
      }
    },
    // Music buttons. Unsupported player actions are dimmed and inactive.
    "controls": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical spacing in terminal rows.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 2,
        // Basic-mode trailing rows. null uses after.
        "basic_after": 1
      },
      // Buttons in display order. [] draws no buttons.
      "buttons": [
        {
          // Button action: previous, play_pause, next, play, pause, or stop. Duplicate actions are not allowed.
          "action": "previous",
          // Button icon or text. An empty string uses the default action symbol. Nerd Font glyphs require a compatible font.
          "text": "󰒮",
          // Button text color. Unavailable controls are dimmed, including when using the terminal default.
          "style": {
            // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
            "color": "foreground"
          },
          // Key sequence for this action while the dock is visible and the player supports it. For example ["f6"]. Use null to disable the key.
          "key": ["f5"]
        },
        {
          // Button action: previous, play_pause, next, play, pause, or stop. Duplicate actions are not allowed.
          "action": "play_pause",
          // Button icon or text. An empty string uses the default action symbol. Nerd Font glyphs require a compatible font.
          "text": "󰐎",
          // Button text color. Unavailable controls are dimmed, including when using the terminal default.
          "style": {
            // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
            "color": "foreground"
          },
          // Key sequence for this action while the dock is visible and the player supports it. For example ["f6"]. Use null to disable the key.
          "key": ["f6"]
        },
        {
          // Button action: previous, play_pause, next, play, pause, or stop. Duplicate actions are not allowed.
          "action": "next",
          // Button icon or text. An empty string uses the default action symbol. Nerd Font glyphs require a compatible font.
          "text": "󰒭",
          // Button text color. Unavailable controls are dimmed, including when using the terminal default.
          "style": {
            // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
            "color": "foreground"
          },
          // Key sequence for this action while the dock is visible and the player supports it. For example ["f6"]. Use null to disable the key.
          "key": ["f7"]
        }
      ]
    },
    // Shortcut entries, visibility and spacing. Disabling releases their keys.
    "shortcuts": {
      // Show this widget. false removes its content and trailing spacing.
      "enabled": true,
      // Vertical rows and horizontal cells between shortcut entries.
      "spacing": {
        // Nonnegative blank rows after this widget. If the dock cannot fit, it falls back to basic or hidden.
        "after": 1,
        // Basic-mode trailing rows. null uses after.
        "basic_after": null,
        // Horizontal cells between entries. Reduced when space is limited.
        "gap": 2
      },
      // Shortcut and separator entries. Omitted or [] leaves all numbered slots empty.
      "items": [
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 1,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "fzf",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "Find",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-1"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#e67e80"
          }
        },
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 2,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "yazi",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "File",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-2"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#e69875"
          }
        },
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 3,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "htop",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "Sys",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-3"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#dbbc7f"
          }
        },
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 4,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "vim",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "Vim",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-4"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#83c092"
          }
        },
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 5,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "lazygit",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "Git",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-5"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#7fbbb3"
          }
        },
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 6,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "firefox &",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "Web",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-6"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#84c8fa"
          }
        },
        {
          // Slot occupied by the separator. Must be unique across all entries.
          "slot": 7,
          // separator marks a non-executable divider. command and key are not allowed.
          "type": "separator",
          // Single-line text displayed as the separator.
          "text": "│",
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#6b7280"
          }
        },
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 8,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "vim ~/ish/dok/config.jsonc",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "Dock",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-7"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#a6a1fb"
          }
        },
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 9,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "vim ~/ish/.ishrc.py",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "Conf",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-8"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#d699b6"
          }
        },
        {
          // Shortcut slot number. Must be unique across all entries.
          "slot": 10,
          // Shell command prepended to the current prompt buffer. Runs on its own when the buffer is empty.
          "command": "ish_reload",
          // Icon or emoji. Nerd Font glyphs require a compatible font. An empty string is allowed.
          "icon": "",
          // Executable shortcut entry type.
          "type": "shortcut",
          // Label after the icon. May be omitted when space is limited.
          "label": "Rld",
          // Shortcut key sequence. Examples: ["c-1"], ["escape", "1"]. null registers no key. Ctrl+number requires terminal key mappings.
          "key": ["c-9"],
          // Enable this shortcut. false dims it and disables execution by click or keyboard.
          "enabled": true,
          // Entry foreground color.
          "style": {
            // Foreground color in #RRGGBB format.
            "color": "#c084fc"
          }
        }
      ]
    }
  },
  // MPRIS discovery, player selection and control. Independent of audio capture.
  "media": {
    // Connect to MPRIS players on the Linux session bus while the dock is visible.
    "enabled": true,
    // Exact MPRIS bus name, or null to select a playing player and retain it until it exits.
    "player": null,
    // Positive finite seconds between player state queries while visible. No polling while hidden.
    "refresh_s": 1.0,
    // Positive finite timeout in seconds for each D-Bus request. Failed commands are never retried.
    "timeout_s": 2.0
  },
  // Linux CPU, memory and network sampling. WSL metrics do not represent the entire Windows host.
  "system": {
    // Collect Linux system metrics while a system toolbar is visible.
    "enabled": true,
    // Positive finite seconds between samples. Sampling runs outside the UI thread.
    "refresh_s": 1.0,
    // Sample interval while the dock is hidden or a general popup is focused. The visible toolbar keeps updating. null uses refresh_s; history and counter baselines are preserved when switching.
    "idle_s": 3.0,
    // Recent samples to keep in memory for graphs. Zero keeps only the current reading.
    "history": 120,
    // Network interfaces to sum, for example ["eth0"]. null selects active non-loopback interfaces; bridges/VPNs may count traffic twice.
    "interfaces": null
  },
  // Left-aligned date and prompt status, with system metrics at the right edge.
  "toolbar": {
    // Let dok define the existing ish bottom toolbar. Disabling restores its previous content.
    "enabled": true,
    // Separator between items. The left/right gap expands to fill the terminal.
    "separator": "  ",
    // Far-left date and weekday, using the shared clock settings.
    "date": {
      // Show the date at the far left.
      "enabled": true,
      // Hide this date only while the dock is actually painted, in either basic or maximized mode.
      "hide_with_dock": true,
      // Date format using the shared clock timezone. %a and %A use the weekday labels below.
      "format": "%Y-%m-%d(%a)",
      // null uses localized weekday abbreviations (English: Mon through Sun). An array supplies seven custom labels, Monday through Sunday.
      "weekdays": null,
      // Date foreground color.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground"
      }
    },
    // Left-hand shell prompt status fields.
    "input": {
      // Show status of the shell prompt buffer, excluding prompt decoration and suggestions.
      "enabled": true,
      // Input status items in order within each group. Length and lines form the first group. Cursor and editor fields form the next.
      "items": [
        {
          // Prompt value to show. Length/columns/positions count Unicode code points, not terminal cells. Positions are one-based.
          "field": "length",
          // Text before the value. null uses the field's localized label (English: Len:, Lines:, Ln:, Col:, Pos:); strings are preserved verbatim.
          "label": null,
          // Show this input status item.
          "enabled": true,
          // Input status foreground color.
          "style": {
            // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
            "color": "foreground"
          },
          // Fixed value width in cells, or null to fit the displayed value without extra padding. Use the region gap for spacing between items.
          "value_width": null
        },
        {
          // Prompt value to show. Length/columns/positions count Unicode code points, not terminal cells. Positions are one-based.
          "field": "lines",
          // Text before the value. null uses the field's localized label (English: Len:, Lines:, Ln:, Col:, Pos:); strings are preserved verbatim.
          "label": null,
          // Show this input status item.
          "enabled": true,
          // Input status foreground color.
          "style": {
            // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
            "color": "foreground"
          },
          // Fixed value width in cells, or null to fit the displayed value without extra padding. Use the region gap for spacing between items.
          "value_width": null
        },
        {
          // Prompt value to show. Length/columns/positions count Unicode code points, not terminal cells. Positions are one-based.
          "field": "line",
          // Text before the value. null uses the field's localized label (English: Len:, Lines:, Ln:, Col:, Pos:); strings are preserved verbatim.
          "label": null,
          // Show this input status item.
          "enabled": true,
          // Input status foreground color.
          "style": {
            // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
            "color": "foreground"
          },
          // Fixed value width in cells, or null to fit the displayed value without extra padding. Use the region gap for spacing between items.
          "value_width": null
        },
        {
          // Prompt value to show. Length/columns/positions count Unicode code points, not terminal cells. Positions are one-based.
          "field": "column",
          // Text before the value. null uses the field's localized label (English: Len:, Lines:, Ln:, Col:, Pos:); strings are preserved verbatim.
          "label": null,
          // Show this input status item.
          "enabled": true,
          // Input status foreground color.
          "style": {
            // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
            "color": "foreground"
          },
          // Fixed value width in cells, or null to fit the displayed value without extra padding. Use the region gap for spacing between items.
          "value_width": null
        },
        {
          // Prompt value to show. Length/columns/positions count Unicode code points, not terminal cells. Positions are one-based.
          "field": "position",
          // Text before the value. null uses the field's localized label (English: Len:, Lines:, Ln:, Col:, Pos:); strings are preserved verbatim.
          "label": null,
          // Show this input status item.
          "enabled": true,
          // Input status foreground color.
          "style": {
            // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
            "color": "foreground"
          },
          // Fixed value width in cells, or null to fit the displayed value without extra padding. Use the region gap for spacing between items.
          "value_width": null
        }
      ]
    },
    // Numeric sum and mean after the input status fields.
    "numbers": {
      // Show the sum and mean of extracted numbers; never executes expressions.
      "enabled": true,
      // selection uses the prompt's selected ranges; input uses the entire prompt buffer. Terminal-native mouse selection is not visible to dok.
      "scope": "input",
      // Text before sum(mean). null uses the UI language (English: Total: ); a string is preserved verbatim.
      "label": null,
      // Optional fractional-place limit before display, rounded half up. null uses the calculated precision.
      "decimals": null,
      // Shown when no numbers are selected/found.
      "empty": "—",
      // Shown if a calculation exceeds 100,000 input characters, 10,000 numbers or 256 digits per number.
      "overflow": "…",
      // Sum and mean foreground color.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground"
      },
      // Fixed width for sum(mean), or null to fit the displayed result without extra padding. Use region gaps for spacing.
      "value_width": null
    },
    // Right-aligned CPU, memory and network display.
    "system": {
      // Keep system metrics aligned to the right edge of the toolbar.
      "enabled": true,
      // Metric display order and priority; later metrics are omitted first if their text cannot fit.
      "order": ["cpu", "memory", "network"],
      // Average CPU utilization and eight-level history graph on a fixed 0–100% scale. The unused leading history uses the lowest block from startup; the numeric value stays unknown until measured.
      "cpu": {
        // Show this metric in the right-hand group.
        "enabled": true,
        // Metric icon or label, usually a Nerd Font glyph.
        "label": "",
        // Metric text and graph foreground color.
        "style": {
          // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "color": "cpu"
        },
        // Graph visibility and maximum length.
        "graph": {
          // Show a compact graph; it shrinks before any text is removed.
          "enabled": true,
          // Maximum terminal cells. CPU uses one sample per cell with eight block heights (12.5% steps); network uses two Braille samples per cell; memory uses a thin capacity bar.
          "width": 12
        },
        // Fixed terminal cells for the right-aligned value, excluding the metric label and graph. Longer values are clipped with an ellipsis.
        "value_width": 4
      },
      // Memory utilization percentage and optional capacity bar.
      "memory": {
        // Show this metric in the right-hand group.
        "enabled": true,
        // Metric icon or label, usually a Nerd Font glyph.
        "label": "",
        // Metric text and graph foreground color.
        "style": {
          // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "color": "memory"
        },
        // Graph visibility and maximum length.
        "graph": {
          // Show a compact graph; it shrinks before any text is removed.
          "enabled": true,
          // Maximum terminal cells. CPU uses one sample per cell with eight block heights (12.5% steps); network uses two Braille samples per cell; memory uses a thin capacity bar.
          "width": 12
        },
        // Fixed terminal cells for the right-aligned value, excluding the metric label and graph. Longer values are clipped with an ellipsis.
        "value_width": 4
      },
      // Receive/send rates and optional combined-traffic history graph.
      "network": {
        // Show this metric in the right-hand group.
        "enabled": true,
        // Network icon or text. The default network glyph requires a Nerd Font.
        "label": "󰛳",
        // Metric text and graph foreground color.
        "style": {
          // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "color": "network"
        },
        // Graph visibility and maximum length.
        "graph": {
          // Show a compact graph; it shrinks before any text is removed.
          "enabled": false,
          // Maximum terminal cells. CPU uses one sample per cell with eight block heights (12.5% steps); network uses two Braille samples per cell; memory uses a thin capacity bar.
          "width": 12
        },
        // Fixed terminal cells for the right-aligned value, excluding the metric label and graph. Longer values are clipped with an ellipsis.
        "value_width": 27
      },
      // Receive-rate label.
      "download_label": "↓",
      // Send-rate label.
      "upload_label": "↑"
    },
    // Spaces between visible date, input size, cursor and numeric summary groups.
    "gap": 4,
    // Width, padding, internal gaps and colors for each toolbar region.
    "regions": {
      // Date and weekday region.
      "date": {
        // Positive content width in cells, including internal gaps and graphs. null fits the contents. Outer padding is added separately.
        "width": null,
        // Padding cells before this region.
        "pad_left": 0,
        // Padding cells after this region. null uses the normal separator between visible regions.
        "pad_right": 4,
        // Nonnegative spaces between fields, the sum label and result, or metric labels, values and graphs. null uses their usual spacing. Date text uses date.format.
        "gap": null,
        // Optional foreground and background overrides for this entire region.
        "style": {
          // Theme role or palette name for every element and padding cell in this region. null uses individual element selectors.
          "color": null,
          // Theme role or palette name for the region including padding. null inherits toolbar.background; use background for the shared theme background.
          "background": null
        }
      },
      // Length and line count region.
      "size": {
        // Positive content width in cells, including internal gaps and graphs. null fits the contents. Outer padding is added separately.
        "width": null,
        // Padding cells before this region.
        "pad_left": 0,
        // Padding cells after this region. null uses the normal separator between visible regions.
        "pad_right": null,
        // Nonnegative spaces between fields, the sum label and result, or metric labels, values and graphs. null uses their usual spacing. Date text uses date.format.
        "gap": 2,
        // Optional foreground and background overrides for this entire region.
        "style": {
          // Theme role or palette name for every element and padding cell in this region. null uses individual element selectors.
          "color": null,
          // Theme role or palette name for the region including padding. null inherits toolbar.background; use background for the shared theme background.
          "background": null
        },
        // Align values within their fields: left or right. Labels stay in place.
        "align": "left",
        // Maximum displayed digits per number; null shows all digits. On overflow try K/M/B/T, then leading digits and three dots. Sum and mean are limited separately.
        "digits": null
      },
      // Line, column, position and optional editor fields.
      "cursor": {
        // Positive content width in cells, including internal gaps and graphs. null fits the contents. Outer padding is added separately.
        "width": null,
        // Padding cells before this region.
        "pad_left": 0,
        // Padding cells after this region. null uses the normal separator between visible regions.
        "pad_right": null,
        // Nonnegative spaces between fields, the sum label and result, or metric labels, values and graphs. null uses their usual spacing. Date text uses date.format.
        "gap": 2,
        // Optional foreground and background overrides for this entire region.
        "style": {
          // Theme role or palette name for every element and padding cell in this region. null uses individual element selectors.
          "color": null,
          // Theme role or palette name for the region including padding. null inherits toolbar.background; use background for the shared theme background.
          "background": null
        },
        // Align values within their fields: left or right. Labels stay in place.
        "align": "left",
        // Maximum displayed digits per number; null shows all digits. On overflow try K/M/B/T, then leading digits and three dots. Sum and mean are limited separately.
        "digits": null
      },
      // Numeric sum and mean region.
      "numbers": {
        // Positive content width in cells, including internal gaps and graphs. null fits the contents. Outer padding is added separately.
        "width": null,
        // Padding cells before this region.
        "pad_left": 0,
        // Padding cells after this region. null uses the normal separator between visible regions.
        "pad_right": null,
        // Nonnegative spaces between fields, the sum label and result, or metric labels, values and graphs. null uses their usual spacing. Date text uses date.format.
        "gap": 2,
        // Optional foreground and background overrides for this entire region.
        "style": {
          // Theme role or palette name for every element and padding cell in this region. null uses individual element selectors.
          "color": null,
          // Theme role or palette name for the region including padding. null inherits toolbar.background; use background for the shared theme background.
          "background": null
        },
        // Align values within their fields: left or right. Labels stay in place.
        "align": "left",
        // Maximum displayed digits per number; null shows all digits. On overflow try K/M/B/T, then leading digits and three dots. Sum and mean are limited separately.
        "digits": null
      },
      // CPU label, value and graph region.
      "cpu": {
        // Positive content width in cells, including internal gaps and graphs. null fits the contents. Outer padding is added separately.
        "width": 19,
        // Padding cells before this region.
        "pad_left": 0,
        // Padding cells after this region. null uses the normal separator between visible regions.
        "pad_right": null,
        // Nonnegative spaces between fields, the sum label and result, or metric labels, values and graphs. null uses their usual spacing. Date text uses date.format.
        "gap": null,
        // Optional foreground and background overrides for this entire region.
        "style": {
          // Theme role or palette name for every element and padding cell in this region. null uses individual element selectors.
          "color": null,
          // Theme role or palette name for the region including padding. null inherits toolbar.background; use background for the shared theme background.
          "background": null
        }
      },
      // Memory label, percentage and graph region.
      "memory": {
        // Positive content width in cells, including internal gaps and graphs. null fits the contents. Outer padding is added separately.
        "width": 19,
        // Padding cells before this region.
        "pad_left": 0,
        // Padding cells after this region. null uses the normal separator between visible regions.
        "pad_right": null,
        // Nonnegative spaces between fields, the sum label and result, or metric labels, values and graphs. null uses their usual spacing. Date text uses date.format.
        "gap": null,
        // Optional foreground and background overrides for this entire region.
        "style": {
          // Theme role or palette name for every element and padding cell in this region. null uses individual element selectors.
          "color": null,
          // Theme role or palette name for the region including padding. null inherits toolbar.background; use background for the shared theme background.
          "background": null
        }
      },
      // Network label, receive/send values and graph region.
      "network": {
        // Positive content width in cells, including internal gaps and graphs. null fits the contents. Outer padding is added separately.
        "width": 19,
        // Padding cells before this region.
        "pad_left": 0,
        // Padding cells after this region. null uses the normal separator between visible regions.
        "pad_right": null,
        // Nonnegative spaces between fields, the sum label and result, or metric labels, values and graphs. null uses their usual spacing. Date text uses date.format.
        "gap": null,
        // Optional foreground and background overrides for this entire region.
        "style": {
          // Theme role or palette name for every element and padding cell in this region. null uses individual element selectors.
          "color": null,
          // Theme role or palette name for the region including padding. null inherits toolbar.background; use background for the shared theme background.
          "background": null
        }
      }
    },
    // Toolbar background including the center gap and outer padding. Use a theme role/palette name or #RRGGBB for a toolbar-only override. background follows the shared theme background. Runtime default: background; newly generated files: #1D2035.
    "background": "#1d2035",
    // Nonnegative blank cells at the left edge of the entire toolbar. Runtime default: 0; newly generated files: 1. Fitted to the terminal width; left padding is reserved first if both edges cannot fit.
    "pad_left": 1,
    // Nonnegative blank cells at the right edge of the entire toolbar. System metrics align immediately before this padding. Runtime default: 0; newly generated files: 1. Fitted to the width remaining after left padding.
    "pad_right": 1,
    // Initial visibility of shortcut help in the bottom toolbar center. Hidden by default. hint_key toggles it for the current session without changing this file. The whole help line hides when it cannot fit between left fields and right metrics. Popup footers stay visible.
    "hints": false,
    // Toggle only the bottom toolbar center help, including while a popup is focused. Default F1; null disables the shortcut. Does not hide popup footer help.
    "hint_key": ["f1"]
  },
  // Centered calendar/weather popups and bottom-right notifications. Focused general popups always support mouse actions; notifications follow dock.mouse.enabled.
  "popups": {
    // Centered popup defaults within the ish input area.
    "general": {
      // Popup width.
      "width": {
        // fixed counts terminal cells; ratio is a fraction of the available input area.
        "mode": "fixed",
        // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
        "value": 72
      },
      // Popup height.
      "height": {
        // fixed counts terminal cells; ratio is a fraction of the available input area.
        "mode": "fixed",
        // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
        "value": 20
      },
      // Space outside the panel. General popups center in the remaining input area; notifications align bottom right.
      "margin": {
        // Nonnegative top rows, fitted to the viewport.
        "top": 1,
        // Nonnegative right cells, fitted to the viewport.
        "right": 1,
        // Nonnegative bottom rows, fitted to the viewport.
        "bottom": 1,
        // Nonnegative left cells, fitted to the viewport.
        "left": 1
      },
      // Space inside the panel; reduced when needed to keep content visible.
      "padding": {
        // Nonnegative top rows, fitted to the viewport.
        "top": 0,
        // Nonnegative right cells, fitted to the viewport.
        "right": 1,
        // Nonnegative bottom rows, fitted to the viewport.
        "bottom": 0,
        // Nonnegative left cells, fitted to the viewport.
        "left": 1
      },
      // Draw a box border when the viewport has room.
      "border": true,
      // Panel text, background and border colors.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground",
        // Panel background. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "background": "background",
        // Panel border. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "border_color": "separator"
      }
    },
    // Non-focusing bottom-right notification queue.
    "notifications": {
      // Allow queued in-process notifications. Disabling clears pending notifications.
      "enabled": true,
      // Small bottom-right panel above the bottom toolbar.
      "panel": {
        // Popup width.
        "width": {
          // fixed counts terminal cells; ratio is a fraction of the available input area.
          "mode": "fixed",
          // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
          "value": 40
        },
        // Popup height.
        "height": {
          // fixed counts terminal cells; ratio is a fraction of the available input area.
          "mode": "fixed",
          // Maximum notification height. Short content shrinks the panel so only the configured body padding remains above the key-map footer.
          "value": 10
        },
        // Space outside the panel. General popups center in the remaining input area; notifications align bottom right.
        "margin": {
          // Nonnegative top rows, fitted to the viewport.
          "top": 1,
          // Nonnegative right cells, fitted to the viewport.
          "right": 1,
          // Nonnegative bottom rows, fitted to the viewport.
          "bottom": 1,
          // Nonnegative left cells, fitted to the viewport.
          "left": 1
        },
        // Notification body padding. Defaults to one row below the title and above the key-map footer, and one cell on each side. Zero removes that padding; fitted to the available viewport.
        "padding": {
          // Nonnegative top rows, fitted to the viewport.
          "top": 1,
          // Nonnegative right cells, fitted to the viewport.
          "right": 1,
          // Nonnegative bottom rows, fitted to the viewport.
          "bottom": 1,
          // Nonnegative left cells, fitted to the viewport.
          "left": 1
        },
        // Draw a box border when the viewport has room.
        "border": true,
        // Panel text, background and border colors.
        "style": {
          // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "color": "foreground",
          // Panel background. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "background": "background",
          // Panel border. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "border_color": "separator"
        }
      },
      // Visible seconds before closing; null requires dismissal. Countdown pauses while hidden or a general popup is open.
      "duration_s": 6,
      // Dismiss the visible notification. Default Alt+X; null disables this binding.
      "dismiss_key": ["escape", "x"],
      // Open details for the visible notification. Default Alt+N; null disables this binding.
      "details_key": ["escape", "n"]
    },
    // Monthly calendar popup.
    "calendar": {
      // Enable the monthly calendar popup and local reminders. External sources and provider writes are separately opt-in.
      "enabled": true,
      // Open or close the calendar. Default Alt+C; null disables this binding. Escape goes back within the popup instead of closing it.
      "key": ["escape", "c"],
      // Calendar size and appearance. null uses popups.general; the default fits both calendar and editor within the available input area.
      "panel": {
        // Popup width.
        "width": {
          // fixed counts terminal cells; ratio is a fraction of the available input area.
          "mode": "fixed",
          // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
          "value": 136
        },
        // Popup height.
        "height": {
          // fixed counts terminal cells; ratio is a fraction of the available input area.
          "mode": "fixed",
          // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
          "value": 44
        },
        // Space outside the panel. General popups center in the remaining input area; notifications align bottom right.
        "margin": {
          // Nonnegative top rows, fitted to the viewport.
          "top": 1,
          // Nonnegative right cells, fitted to the viewport.
          "right": 1,
          // Nonnegative bottom rows, fitted to the viewport.
          "bottom": 1,
          // Nonnegative left cells, fitted to the viewport.
          "left": 1
        },
        // Space inside the panel; reduced when needed to keep content visible.
        "padding": {
          // Nonnegative top rows, fitted to the viewport.
          "top": 0,
          // Nonnegative right cells, fitted to the viewport.
          "right": 1,
          // Nonnegative bottom rows, fitted to the viewport.
          "bottom": 0,
          // Nonnegative left cells, fitted to the viewport.
          "left": 1
        },
        // Draw a box border when the viewport has room.
        "border": true,
        // Panel text, background and border colors.
        "style": {
          // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "color": "foreground",
          // Panel background. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "background": "background",
          // Panel border. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "border_color": "separator"
        }
      },
      // First column weekday: 0 Monday through 6 Sunday. Default Sunday.
      "week_start": 6,
      // Deliver saved reminders while ish is running. Missed reminders coalesce to the latest occurrence per registered offset; receipts survive restart.
      "reminders": true,
      // Seconds between external calendar file checks while the calendar popup is open. Saved changes and due alarms wake immediately.
      "poll_s": 1,
      // Seconds between external calendar file checks while the calendar popup is closed. Known alarms keep their exact deadlines; this is only the external-edit detection interval.
      "idle_s": 30,
      // Lightweight wall-clock recheck interval while a future alarm exists, including after suspend or a clock change. Does not reread the calendar file.
      "clock_s": 1,
      // Calendars shown with local events. Sources reference a connections account; provider settings control optional writes. The visible month is cached. Explicit dok reminders/commands also keep their linked schedules refreshed while the popup is closed; imported text never supplies executable commands.
      "sources": [
        {
          // Configured connection identifier. The selected connection must support calendar reads.
          "connection": "google",
          // Provider calendar identifier. Google accepts primary for the account's main calendar, or a calendar ID from its settings.
          "calendar": "primary",
          // Source name shown next to external events. Distinguish accounts/calendars here.
          "label": "Google",
          // Enable this calendar source and its explicitly configured dok actions. Editing additionally requires provider write settings and calendar permissions.
          "enabled": false,
          // Refresh interval for the visible month and schedules with dok reminders/commands. Hidden popups read only action-linked schedules. F5 explicitly refreshes.
          "refresh_s": 300
        }
      ]
    },
    // Current, daily and hourly weather details popup.
    "weather": {
      // Enable current, daily and hourly weather details, sharing the dashboard cache.
      "enabled": true,
      // Open or close weather details. Default Alt+W; null disables this binding. Escape returns from buttons to hours without closing the popup.
      "key": ["escape", "w"],
      // Weather panel dimensions. null uses popups.general.
      "panel": {
        // Popup width.
        "width": {
          // fixed counts terminal cells; ratio is a fraction of the available input area.
          "mode": "fixed",
          // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
          "value": 112
        },
        // Popup height.
        "height": {
          // fixed counts terminal cells; ratio is a fraction of the available input area.
          "mode": "fixed",
          // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
          "value": 36
        },
        // Space outside the panel. General popups center in the remaining input area; notifications align bottom right.
        "margin": {
          // Nonnegative top rows, fitted to the viewport.
          "top": 1,
          // Nonnegative right cells, fitted to the viewport.
          "right": 1,
          // Nonnegative bottom rows, fitted to the viewport.
          "bottom": 1,
          // Nonnegative left cells, fitted to the viewport.
          "left": 1
        },
        // Space inside the panel; reduced when needed to keep content visible.
        "padding": {
          // Nonnegative top rows, fitted to the viewport.
          "top": 0,
          // Nonnegative right cells, fitted to the viewport.
          "right": 1,
          // Nonnegative bottom rows, fitted to the viewport.
          "bottom": 0,
          // Nonnegative left cells, fitted to the viewport.
          "left": 1
        },
        // Draw a box border when the viewport has room.
        "border": true,
        // Panel text, background and border colors.
        "style": {
          // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "color": "foreground",
          // Panel background. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "background": "background",
          // Panel border. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "border_color": "separator"
        }
      },
      // pyfiglet font for current temperature; plain text is used when the art cannot fit.
      "font": "future",
      // Width of each hourly column, fitted to the viewport.
      "hour_width": 8,
      // Temperature graph height, fitted to the viewport.
      "graph_height": 5
    },
    // Popup-only keyboard timing; shell settings are restored when focus leaves.
    "input": {
      // Seconds to distinguish Escape from terminal/Alt sequences while a popup has focus. Applies to both parser and key binding waits; original host values are restored on exit. Increase for slow remote terminals.
      "escape_s": 0.05
    }
  },
  // Shared named colors and semantic roles. All themed style fields reference these names; shortcuts and the visualizer retain their own RGB colors.
  "theme": {
    // Shared 18-color palette for dock, toolbar and popups. Shortcut RGB colors and visualizer gradients stay independent.
    "colors": {
      // Dark blue-gray surfaces. RGB in #RRGGBB.
      "black": "#253047",
      // Soft coral for destructive actions and warm accents. RGB in #RRGGBB.
      "red": "#e58c76",
      // Lime for save actions and CPU. RGB in #RRGGBB.
      "green": "#a3e635",
      // Warm yellow for warnings. RGB in #RRGGBB.
      "yellow": "#e5c07b",
      // Blue for Saturdays. RGB in #RRGGBB.
      "blue": "#60a5fa",
      // Soft purple for network activity. RGB in #RRGGBB.
      "purple": "#b4a7d6",
      // Cyan for titles and memory. RGB in #RRGGBB.
      "cyan": "#67e8f9",
      // Cool light gray for menus. RGB in #RRGGBB.
      "white": "#a8b2bf",
      // Muted text and low temperatures. RGB in #RRGGBB.
      "comment": "#77818d",
      // Visible dark gray for borders and separators. RGB in #RRGGBB.
      "bright_black": "#475569",
      // Bright coral. RGB in #RRGGBB.
      "bright_red": "#f6a594",
      // Bright lime. RGB in #RRGGBB.
      "bright_green": "#bef264",
      // Bright warm yellow. RGB in #RRGGBB.
      "bright_yellow": "#f3d59e",
      // Bright blue. RGB in #RRGGBB.
      "bright_blue": "#93c5fd",
      // Bright lavender. RGB in #RRGGBB.
      "bright_purple": "#d1c4ef",
      // Bright cyan. RGB in #RRGGBB.
      "bright_cyan": "#a5f3fc",
      // Bright light gray. RGB in #RRGGBB.
      "bright_white": "#e5e7eb",
      // Secondary labels and hints. RGB in #RRGGBB.
      "bright_comment": "#94a3b8"
    },
    // Map UI roles to palette names. null means terminal default, not another role. No hex values or role-to-role aliases here.
    "roles": {
      // Normal text, dates, time, media controls and played track. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "foreground": null,
      // Shared dock, toolbar and popup background; null preserves terminal transparency. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "background": null,
      // Popup titles, focused button text, selected calendar events and weather graph. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "title": "cyan",
      // Title bars, buttons and menu surfaces. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "button_bg": "black",
      // Entire calendar event pane. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "editor_bg": "black",
      // Editable text fields, including empty cells and memo rows. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "input_bg": "bright_black",
      // Save and success actions. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "save": "green",
      // Delete actions and high temperatures. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "delete": "red",
      // Labels, help, remaining track and zero precipitation probability. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "muted": "bright_comment",
      // Borders and solid separators. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "separator": "bright_black",
      // Connection failures and warnings. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "warning": "yellow",
      // Errors. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "error": "red",
      // Inactive placeholders. Unavailable music buttons additionally remain dimmed. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "disabled": "comment",
      // Dropdown item text. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "menu_text": "white",
      // Selected menu item text. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "selected_fg": "black",
      // Selected menu item background. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "selected_bg": "white",
      // Scrollbar thumb; its track uses button_bg. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "scrollbar": "cyan",
      // Toolbar CPU text and graph. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "cpu": "green",
      // Toolbar memory text and graph. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "memory": "cyan",
      // Toolbar network text and graph. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "network": "purple",
      // Calendar Saturdays. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "saturday": "blue",
      // Calendar Sundays. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "sunday": "red",
      // User-registered calendar holidays. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "holiday": "red",
      // Low forecast temperature. Palette name; null uses the terminal default. Bright colors do not imply bold.
      "low_temp": "comment"
    }
  },
  // UI language: null follows ish's selected language with English fallback. "en" selects English; "ko" selects Korean. Custom text, event content and ASCII weekday art are preserved.
  "language": null,
  // Explicit command completion registration. Enter in the prefix/mode form runs the captured prompt command once, analyzes its output and saves the result. Stored catalogs live beside this file.
  "completion": {
    // Enable saved option/subcommand suggestions, registration and management popups. Never executes lookup commands automatically.
    "enabled": true,
    // Open or close the prefix form beneath the prompt cursor. Tab toggles merge/replace while typing continues to edit the prefix. Enter runs the captured prompt command, analyzes its output and registers it. Escape stays at this root form; the opening key cancels. Default Alt+O; null removes the binding.
    "key": ["escape", "o"],
    // After Enter confirms registration, use the installed Hub command-options Agent to analyze output and translate descriptions into dok's selected language. New Agent model defaults come from hub; existing Agents are edited in Hub. Local fallback preserves source descriptions. No shell tools are assigned by dok.
    "hub": true,
    // Hub analysis deadline in seconds. This does not limit or terminate the shell command; normal ish controls apply to it.
    "timeout_s": 60,
    // Completion list appearance, separate from the registration popup. Existing suggestions keep their order and precede generated suggestions; generated names are sorted case-insensitively with punctuation, including leading option dashes. Existing duplicates win.
    "menu": {
      // Item text. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
      "color": "menu_text",
      // Menu background. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
      "background": "button_bg",
      // Item descriptions. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
      "help": "muted",
      // Selected item and description text. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
      "selected_color": "selected_fg",
      // Selected row background. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
      "selected_background": "selected_bg",
      // Render the selected item and its description in bold.
      "selected_bold": false,
      // Scrollbar thumb. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
      "scrollbar": "scrollbar",
      // Scrollbar track. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
      "scrollbar_background": "button_bg",
      // Apply dok's shared theme to the ish completion list, including existing suggestions. false keeps the host style. Menu layout and keyboard behavior stay with ish.
      "enabled": true
    },
    // Cursor-anchored popup size and style. Fits below or above the prompt cursor inside the existing input area.
    "panel": {
      // Popup width.
      "width": {
        // fixed counts terminal cells; ratio is a fraction of the available input area.
        "mode": "fixed",
        // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
        "value": 42
      },
      // Popup height.
      "height": {
        // fixed counts terminal cells; ratio is a fraction of the available input area.
        "mode": "fixed",
        // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
        "value": 5
      },
      // Space outside the panel. General popups center in the remaining input area; notifications align bottom right.
      "margin": {
        // Nonnegative top rows, fitted to the viewport.
        "top": 1,
        // Nonnegative right cells, fitted to the viewport.
        "right": 1,
        // Nonnegative bottom rows, fitted to the viewport.
        "bottom": 1,
        // Nonnegative left cells, fitted to the viewport.
        "left": 1
      },
      // Space inside the panel; reduced when needed to keep content visible.
      "padding": {
        // Nonnegative top rows, fitted to the viewport.
        "top": 0,
        // Nonnegative right cells, fitted to the viewport.
        "right": 1,
        // Nonnegative bottom rows, fitted to the viewport.
        "bottom": 0,
        // Nonnegative left cells, fitted to the viewport.
        "left": 1
      },
      // Draw a box border when the viewport has room.
      "border": true,
      // Panel text, background and border colors.
      "style": {
        // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "color": "foreground",
        // Panel background. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "background": "background",
        // Panel border. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
        "border_color": "separator"
      }
    },
    // Manage prefixes and entries, including manual edits, deletion and collection locks.
    "manage": {
      // Open or close saved completion management. Default Alt+M; null removes this binding. Escape goes back through dropdown, editor and prefix list. Closing a changed draft asks before discarding. No lookup or model call is made.
      "key": ["escape", "m"],
      // Centered completion manager. Changes are staged until Save or F2; closing asks before discarding unsaved changes.
      "panel": {
        // Popup width.
        "width": {
          // fixed counts terminal cells; ratio is a fraction of the available input area.
          "mode": "fixed",
          // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
          "value": 104
        },
        // Popup height.
        "height": {
          // fixed counts terminal cells; ratio is a fraction of the available input area.
          "mode": "fixed",
          // Positive whole cells for fixed; greater than 0 and at most 1 for ratio. Fitted to the viewport.
          "value": 28
        },
        // Space outside the panel. General popups center in the remaining input area; notifications align bottom right.
        "margin": {
          // Nonnegative top rows, fitted to the viewport.
          "top": 1,
          // Nonnegative right cells, fitted to the viewport.
          "right": 1,
          // Nonnegative bottom rows, fitted to the viewport.
          "bottom": 1,
          // Nonnegative left cells, fitted to the viewport.
          "left": 1
        },
        // Space inside the panel; reduced when needed to keep content visible.
        "padding": {
          // Nonnegative top rows, fitted to the viewport.
          "top": 0,
          // Nonnegative right cells, fitted to the viewport.
          "right": 1,
          // Nonnegative bottom rows, fitted to the viewport.
          "bottom": 0,
          // Nonnegative left cells, fitted to the viewport.
          "left": 1
        },
        // Draw a box border when the viewport has room.
        "border": true,
        // Panel text, background and border colors.
        "style": {
          // Foreground. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "color": "foreground",
          // Panel background. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "background": "background",
          // Panel border. Theme role or palette name, e.g. foreground, muted, cyan, bright_cyan. Edit RGB under theme.colors; terminal defaults are selected with null in theme.roles.
          "border_color": "separator"
        }
      }
    }
  },
  // Creation defaults shared by all dok-owned Hub Agents. Agent templates supply fixed reasoning effort and omit temperature. Applied only when Hub creates an absent Agent; existing Agent settings are never overwritten.
  "hub": {
    // Initial provider/model for newly created dok Agents. null leaves it unset. Existing Hub Agent settings are preserved; edit those in Hub.
    "model": null,
    // Initial API key for newly created dok Agents. null omits the override; an explicit empty string is passed through. Saved with the new Agent's completion settings.
    "api_key": null,
    // Initial API endpoint for newly created dok Agents. null omits the override. The llm provider adapter validates HTTP/HTTPS URLs at registration.
    "api_base": null
  },
  // External data connections shared by dok features. Independent of Hub and LLMs. No account is connected automatically.
  "connections": {
    // Google account connections. Empty disables all Google access. Each entry declares its own ID, enabled flag and OAuth client file; credentials are never stored in this settings file.
    "google": [
      {
        // Unique connection ID used by calendar sources. This is a local alias, not your Google email address.
        "id": "google",
        // Allow this account to be used by configured sources. Disabled by default; never opens a login browser automatically.
        "enabled": false,
        // Path to the Google OAuth Desktop app client JSON. Relative paths resolve beside config.jsonc; ~ uses the Linux home. Authenticate with python -m dok.connections login --config PATH --account ID. Tokens are kept separately from settings.
        "client_file": "",
        // HTTP request timeout in seconds for this Google connection.
        "timeout_s": 20,
        // Seconds to wait for the explicit browser OAuth login's localhost callback.
        "login_s": 180,
        // Allow creating, editing and deleting Google events. Enable then log in again to grant calendar.events permission. Actual calendar permissions are still enforced; false keeps read-only access.
        "write": false,
        // Google guest notifications for explicit event saves/deletes: all, externalOnly (non-Google guests), or none. This does not change dok's local reminders.
        "updates": "all"
      }
    ]
  }
}
